# ───────────────────────────────────────────────
# Modal config (override khi deploy)
# ───────────────────────────────────────────────
# Set qua: modal deploy --env-var KEY=VALUE  hoặc edit modal_app.py defaults
MODEL_NAME=Qwen/Qwen3.5-9B-Instruct
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.80
DTYPE=auto
MODAL_GPU=L40S

# ───────────────────────────────────────────────
# RAG retrieval (hybrid: semantic docs/email + structured calendar/task)
# ───────────────────────────────────────────────
USE_RETRIEVAL=true
EMBED_MODEL=BAAI/bge-m3
RAG_TOP_K=4
# Ngưỡng cosine lọc nhiễu semantic (bge-m3): TP ~0.59-0.73, nhiễu ~0.40-0.55.
RAG_MIN_SCORE=0.56
# Ngưỡng cosine cho EMBEDDING router (so query với câu mẫu intent calendar/task/email).
# Same-intent ~0.6-0.8, cross-intent ~0.3-0.5. Hạ nếu miss intent, nâng nếu over-route.
# 0.59 = điểm ngọt đo bằng eval/rag_diagnose.py trên corpus phong phú (34 case rag_live):
# recall@4 100%, refuse 3/4 clean. RL06 (task≈0.591) là ràng buộc khít cận dưới.
RAG_ROUTE_MIN_SCORE=0.59
# Ngày "hôm nay" của trợ lý — neo cho structured query (calendar/task theo ngày tương đối).
RAG_REFERENCE_DATE=2026-05-27

# ───────────────────────────────────────────────
# Client config (chạy local trên máy để gọi endpoint)
# ───────────────────────────────────────────────
# URL hiển thị sau khi 'modal deploy modal_app.py'
MODAL_ENDPOINT_URL=

# Optional: HF token nếu model gated (Gemma, ...)
HUGGING_FACE_HUB_TOKEN=

# ───────────────────────────────────────────────
# Eval — target model (CHỈ Modal local, không còn DashScope cloud)
# ───────────────────────────────────────────────
# Mode: 'sdk' = gọi qua Modal SDK (LLMServer.generate.remote)
#       'http' = gọi qua HTTP endpoint (yêu cầu MODAL_ENDPOINT_URL ở trên)
EVAL_MODE=sdk

# ───────────────────────────────────────────────
# LLM-as-Judge (Gemini)
# ───────────────────────────────────────────────
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
JUDGE_MODEL=gemini-2.5-flash
# Optional: chấm bằng nhiều judge, phân tách dấu phẩy. Nếu set biến này, nó override JUDGE_MODEL.
# Mỗi judge sẽ có report riêng + một report consensus multi-judge.
# JUDGE_MODELS=gemini-2.5-flash,deepseek-v4-flash,qwen/qwen3.6-flash,nvidia/nemotron-3-ultra-550b-a55b:free
JUDGE_TEMPERATURE=0.0
EVAL_MAX_TOKENS=512
EVAL_TEMPERATURE=0.2
EVAL_GENERATE_WORKERS=1
# Giới hạn request/phút cho judge API (free-tier Gemini = 15). Set 0 để tắt rate limit.
JUDGE_RPM=15

# Optional: nếu judge model bắt đầu bằng "deepseek" thì dùng DeepSeek OpenAI-compatible API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=true

# Optional: judge model dạng provider/model trên OpenRouter, ví dụ qwen/qwen3.6-flash.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=vietnamese-secretary-llm
